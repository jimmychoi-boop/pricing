# Path to Google service account JSON key file
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Gmail credentials for sending recap emails
# Generate an App Password at https://myaccount.google.com/apppasswords
GMAIL_ADDRESS=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# Recipient email (defaults to GMAIL_ADDRESS if not set)
# RECAP_RECIPIENT_EMAIL=someone@example.com

# SQLite database path (default: data/recap.db)
DATABASE_PATH=data/recap.db

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# ── Snowflake warehouse connection ──────────────────────────────────
# Set these to enable Agent B (Metrics Intelligence) to query Snowflake directly.
# When not set, Agent B falls back to stub values from configs/metrics.yaml.
SNOWFLAKE_ACCOUNT=your-account.us-east-1
SNOWFLAKE_USER=your_service_account
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_WAREHOUSE=ANALYTICS_WH
SNOWFLAKE_DATABASE=ANALYTICS
SNOWFLAKE_SCHEMA=PROD
# SNOWFLAKE_ROLE=ANALYTICS_ROLE  # optional

# ── Hex integration (optional) ─────────────────────────────────────
# HEX_API_TOKEN=your-hex-api-token
# HEX_WORKSPACE_ID=your-hex-workspace-id
